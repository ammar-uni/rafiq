# Discord Developer Portal > your application > General Information
DISCORD_APPLICATION_ID=
# Developer Portal > Bot > Token. Keep the real token only in your local .env.
DISCORD_TOKEN=
# Optional: one test server for immediate command registration. Empty = global commands.
DISCORD_GUILD_ID=
# A persistent local directory. Run one Rafiq process against this database.
RAFIQ_DATABASE_PATH=data/rafiq.enc
# Created by npm run setup:local. Keep the key private, outside data backups.
RAFIQ_DATA_KEY=
# Publish the reviewed privacy policy and a working contact/report page before launch.
RAFIQ_PRIVACY_URL=
RAFIQ_SUPPORT_URL=
